// ==UserScript==
// @name         Nico-x2 WatchManager
// @namespace    http://tampermonkey.net/
// @version      6.0
// @description  サイト設定 自動再生オンにすること > 自動遷移後の再生のため
// @author       You
// @match        https://*.nicovideo.jp/*
// @grant        none
// @license      GNU GPLv3
// @icon         https://www.google.com/s2/favicons?domain=www.nicovideo.jp
// @run-at       document-body
// @noframes
// ==/UserScript==

(function() {
  'use strict';

  // ==========================================================
  // 変数宣言
  const waitTime = 1000;
  const regWatch = '/watch';
  // attributes
  // ロード完了後再生
  const cssMain = 'body > div[class="_4wqbwn0" i] > main[class="_4wqbwn1" i] > div';
  // 再生：comment area not open, comment area open
  const cssPlayerArea = cssMain + ' > :is(div[class="_1vg5ukp0" i], div[class="_1vg5ukp0 _1vg5ukp1" i])';
  const cssVideo = cssPlayerArea + ' div[class="vjj3re0" i] video[data-name="video-content" i]';
  const cssVideoBtn = cssPlayerArea + ' div[class="izcw0e0 _1xq99e00" i] > button[class="_1ss5odq0" i]';

  // top controls
  const cssAControls = cssPlayerArea + ' div[class="_9ndw3l0" i]';
  // center controls
  const cssBControls = cssPlayerArea + ' div[class="_10qpu4i0" i]';
  const cssPlayBtn = cssBControls + ' button[class="_10qpu4i6 _10qpu4i1 _1tmkx9h0" i][aria-label="再生" i]';

  const cssCommentArea = cssPlayerArea + ' > div[class="_1ti8yhz0" i]';
  const cssCommentAreaOpen = cssCommentArea + ' > div[class="_1ti8yhz2" i] > button[class="_5jwikj0" i]';
  const cssCommentShow = cssMain + ' > div[class="_1vg5ukp0 _1vg5ukp1" i]';
  const cssCommentHide = cssMain + ' > div[class="_1vg5ukp0" i]';
  const cssCommentBtn = cssAControls + ' > button[class="_9ndw3l1 _1tmkx9h0" i]:has(svg > path[d^="M18 3H6C4.346" i])';

  const cssMoreTxt = cssMain + ' > div[class="_16d7kub0" i] button[class="d8iohg8" i]';
  const cssInfo = cssPlayerArea + ' div[class="wjwcbt0" i][aria-label="動画情報" i] > div[class="m03n2n0" i] > div[class="_1hfvdw30" i]';
  const cssInfoTxt = 'div[class="_1xtfb7p2 _1xtfb7p0" i] > h2[class="_1xtfb7p4 _1xtfb7p3" i]';
  const cssInfoSeriesTxt = 'div:not([class]) > div[class="_1xtfb7p1 _1xtfb7p0" i] > h3[class="_1xtfb7p5 _1xtfb7p3" i]';
  const cssInfoSeriesPath = 'ol a[href*="/watch/sm" i]';

  let oldUrl = '';
  // ==========================================================
  // 静的style適用エリア
  // stylus: beforebegin, afterbegin, beforeend, afterend
  let appendStylus = '';
  // mobile app 販促ヘッダー
  appendStylus += 'body > div[class="_4wqbwn0" i] > div[class="_1t0vmr00" i] { display: none !important; } ';
  appendStylus += 'div[class="_1gc856a0" i]:has(a[href*="tagrelatedbanner" i]) { display: none !important; } ';
  // プレミアム館員 販促
  appendStylus += 'a[href*="/premium" i] { display: none !important; } ';
  const stylusElem = document.createElement('style');
  stylusElem.id = 'stylusElem';
  stylusElem.textContent = appendStylus;
  // ==========================================================

  // eslint-disable-next-line no-unused-vars
  const isNuN = (selector) => {
    if (selector === null || selector === undefined || selector === '') { return true; } else { return false; }
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelector = async (selector, node = document) => {
    let obj = null;
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 100));
      obj = node.querySelector(selector);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelectorCount = async (cnt, selector, node = document) => {
    let obj = null;
    let num = 0;
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 1000));
      if (num < cnt) {
        obj = node.querySelector(selector);
        num++;
        if (!obj) { return obj; }
      } else {
        break;
      }
    }
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 1000));
      obj = node.querySelector(selector);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelectorIframe = async (selector1, selector2, node = document) => {
    let obj = null;
    while (!obj) {
      // iframe.contentWindow.document === iframe.contentDocument
      await new Promise(resolve => setTimeout(resolve, 500));
      obj = node.querySelector(selector1).contentDocument.querySelector(selector2);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const deleteParam = (searchUrl, param) => {
    const base = new URL(location.protocol + '//' + location.hostname);
    const url = new URL(searchUrl, base);
    // URLSearchParamsオブジェクトを取得
    const params = url.searchParams;
    params.delete(param);

    return url;
  };
  // eslint-disable-next-line no-unused-vars
  const searchParams = (searchUrl, param) => {
    const base = new URL(location.protocol + '//' + location.hostname);
    const url = new URL(searchUrl, base);
    console.log('url section', url);
    // URLSearchParamsオブジェクトを取得
    const params = url.searchParams;

    return params.get(param);
  };
  // eslint-disable-next-line no-unused-vars
  const getParam = (name, url) => {
    if (!url) url = window.location.href;
    name = name.replace(/[\\[\]]/g, '\\$&');
    let regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)');
    let results = regex.exec(url);

    if (!results) return null;
    if (!results[2]) return '';
    return decodeURIComponent(results[2].replace(/\+/g, ' '));
  };
  // eslint-disable-next-line no-unused-vars
  const userAgent = () => {
    const userDevice = navigator.userAgent;
    if (userDevice.indexOf('iPhone') > 0 || userDevice.indexOf('iPod') > 0 || userDevice.indexOf('Android') > 0 && userDevice.indexOf('Mobile') > 0) {
      return false;
    } else if (userDevice.indexOf('iPad') > 0 || userDevice.indexOf('Android') > 0) {
      return false;
    } else {
      // pc
      return true;
    }
  };
  // eslint-disable-next-line no-unused-vars
  const stylusNone = (stylus) => {
    if (isNuN(document.querySelector('style#' + stylus))) {
      return true;
    }
    return false;
  };

  const dialogHide = () => {
    // 動画読み込みに失敗
  };
  const nextSeriesNode = async (cnt) => {
    if (10 <= cnt) { return false; }

    const sources = document.querySelectorAll(cssInfo);
    console.log('1 ...', sources);

    for await (const elem of sources) {
      const titleNode = elem.querySelector(cssInfoTxt) ? elem.querySelector(cssInfoTxt).textContent : '';
      console.log('2 ...', titleNode);
      if (titleNode == 'シリーズ') {
        const seriesNode = elem.querySelector(cssInfoSeriesTxt) ? elem.querySelector(cssInfoSeriesTxt).textContent : '';
        console.log('3 ...', seriesNode);
        if (seriesNode == '次の動画') {
          const movieNext = elem.querySelector(cssInfoSeriesPath);
          console.log('next ...', movieNext);
          await new Promise(resolve => setTimeout(resolve, waitTime));
          movieNext.click();
          return false;
        }
      }
    }
    cnt++;
    await new Promise(resolve => setTimeout(resolve, 5000));
    await nextSeriesNode(cnt);
  };
  const playNextWatch = async () => {
    const videoElem = await waitQuerySelector(cssVideo);

    console.log('video loading...');
    videoElem.addEventListener('ended', async () => {
      console.log('next movie waiting...');
      const btnCommentOpen = await waitQuerySelector(cssCommentAreaOpen);
      // コメントエリア開いていた場合、閉じる
      if (document.querySelector(cssCommentShow)) { btnCommentOpen.click(); }
      // もっとみる
      const txt = await waitQuerySelector(cssMoreTxt);
      txt.click();

      await nextSeriesNode(0);
    });
  };
  const playingWatch = async () => {
    await waitQuerySelector(cssMain);
    await waitQuerySelector(cssPlayerArea);
    await waitQuerySelectorCount(10, cssAControls);
    await waitQuerySelectorCount(10, cssBControls);

    console.log('waiting player state... clicker');
    await new Promise(resolve => setTimeout(resolve, waitTime));

    // プレイヤー再生
    console.log('player click'); // 自動再生オンの場合不要
    let btn = null;
    btn = await waitQuerySelectorCount(10, cssVideoBtn);
    if (isNuN(btn)) { btn = await waitQuerySelectorCount(10, cssPlayBtn); }
    // 再生ボタン存在した場合、押下
    if (!isNuN(btn)) {
      await new Promise(resolve => setTimeout(resolve, 5000));
      btn.click(); 
    }

    // コメント画面描画時[x]
    const commentSVG = await waitQuerySelectorCount(10, cssCommentBtn);
    if (!isNuN(commentSVG)) { commentSVG.click(); }

    const btnCommentOpen = await waitQuerySelector(cssCommentAreaOpen);
    // コメントエリア閉じていた場合、開く
    if (document.querySelector(cssCommentHide)) { btnCommentOpen.click(); }
  };
  const changeUrl = () => {
    const observer = new MutationObserver(() => {
      setTimeout(() => { // 遅延
        window.dispatchEvent(new CustomEvent('urlChange', {'detail': { 'href': window.location.href, 'path': window.location.pathname, 'host': window.location.hostname, 'search': window.location.search }})); // イベントを発火
      }, 50);
    });
    const config = { 'subtree': true, 'childList': true, 'attributes': false, 'characterData': false };
    observer.observe(document.body, config);
  };
  // URL検知
  window.addEventListener('urlChange', async (e) => {
    if (oldUrl !== e.detail.path) {
      oldUrl = e.detail.path; // oldUrlを更新

      dialogHide();

      if (new RegExp(regWatch, 'gis').test(location.pathname)) {
        console.log(location.hostname, 'www.nicovideo.jp' === location.hostname);
        if ('www.nicovideo.jp' === location.hostname) {
          console.log('pc > ');
          playingWatch();
          playNextWatch();
        } else {
          console.log('sp > ');
          playingWatch();
          playNextWatch();
        }
      }
    }
  });
  const eventHandler = () => {
    if (stylusNone(stylusElem.id)) { document.body.insertAdjacentElement('afterbegin', stylusElem); }
    changeUrl();
  };

  if (document.readyState !== 'loading') {
    // DOM解析が完了している場合は即実行
    eventHandler();
  } else {
    // DOM生成されたとき
    document.addEventListener('DOMContentLoaded', eventHandler());
  }
})();
