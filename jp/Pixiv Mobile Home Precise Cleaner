// ==UserScript==
// @name         Pixiv Mobile Home Precise Cleaner
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  pixivのモバイル版ホームから指定された要素および広告・プレミアム誘導を非表示にします
// @author       AI
// @match        https://www.pixiv.net/*
// @icon         https://www.pixiv.net/favicon.ico
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
  'use strict';

  const css = [
    '.w-full[data-ga4-label="trend_tag_section_content" i]',
    '.w-full[data-ga4-label="ranking_content" i]',
    '.w-full[data-ga4-label="lead_content" i]',
    '.w-full[data-ga4-label="pixivision_content" i]',
    '.w-full:has([data-ga4-entity-id^="collection/" i])',
    '.w-full:has([data-ga4-entity-id^="novel" i])',
    'div[class="sc-62a9fca4-0 bVmyEQ h-64" i] > div > div > div > .w-full:has(a[href^="/premium" i])',
    '.w-full:has(> .w-full > a[href^="/premium" i])',
    '.flex-col > section:has(a[href^="/premium/" i])',
    'div > div[class="sc-3517b0ae-2 sc-3517b0ae-4 fiHasW hoXTiH" i]',
  ].join(', ');
  const cssTagNames = [
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="叶" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="葛葉" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="加賀美" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="甲斐田" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="月ノ" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="卯月コウ" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="伏見" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="剣持" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="社築" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="不破" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="イブラヒム" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="ローレン" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="伊波" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="ましろ" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="咎人" i], [data-cr-data*="トリガー" i])',
    'div[data-ga4-label="home_recommend" i] > .w-full > div[data-ga4-label="work_content" i]:is([data-cr-data*="MADTOWN" i])',
  ].join(', ');
  let cssAppended = '';
  cssAppended += css + ' { display: none !important; } ';
  cssAppended += cssTagNames + ' { display: none !important; } ';

  function injectStyle() {
    if (document.getElementById('pixiv-precise-cleaner')) return;
    const style = document.createElement('style');
    style.id = 'pixiv-precise-cleaner';
    style.type = 'text/css';
    style.appendChild(document.createTextNode(cssAppended));
    (document.head || document.documentElement).appendChild(style);
  }

  if (document.documentElement) {
    injectStyle();
  }

  const observer = new MutationObserver(() => {
    injectStyle();
  });

  if (document.body) {
    observer.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      injectStyle();
      observer.observe(document.body, { childList: true, subtree: true });
    });
  }
})();
