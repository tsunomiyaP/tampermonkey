// ==UserScript==
// @name         Youtube PageManager
// @namespace    http://tampermonkey.net/
// @version      6.1
// @description  try to take over the world!
// @author       You
// @match        https://*.youtube.com/*
// @exclude      https://music.youtube.com/*
// @exclude      https://studio.youtube.com/*
// @grant        none
// @license      GNU GPLv3
// @icon         https://www.google.com/s2/favicons?domain=youtube.com
// @run-at       document-body
// @noframes
// ==/UserScript==

(function() {
  'use strict';

  // ==========================================================
  // 変数宣言
  const waitTime = 1000;
  const scale = 'scale(0.8)';
  const manager = 'ytd-app, ytm-app[id="app"i]';
  const itemsArray = [
    { device: 'www.youtube.com', path: '^/$|^/index', area: '[page-subtype="home"i] div#primary > ytd-rich-grid-renderer > div#contents', stylus: 'transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'www.youtube.com', path: '^/feed/subscriptions', area: '[page-subtype="subscriptions"i] div#primary > ytd-rich-grid-renderer > div#contents', stylus: 'transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'www.youtube.com', path: '^/watch|^/live', area: 'ytd-watch-flexy div#related div#items', stylus: 'transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'www.youtube.com', path: '^/@.+/(videos|streams)|^/channel/.+/(videos|streams)|^/c/.+/(videos|streams)|^/user/.+/(videos|streams)|^/u/.+/(videos|streams)', area: '[page-subtype="channels"i] div#primary > ytd-rich-grid-renderer > div#contents', stylus: 'transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'www.youtube.com', path: '^/results', area: 'ytd-search div#primary > ytd-section-list-renderer > div#contents', stylus: 'transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'm.youtube.com', path: '^/$|^/index', area: 'div.tab-content[tab-identifier="FEwhat_to_watch"i] div.rich-grid-renderer-contents', stylus: 'display: block; transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'm.youtube.com', path: '^/feed/subscriptions', area: 'div.tab-content[tab-identifier="FEsubscriptions"i] > ytm-tab-renderer > * > :is(lazy-list, div.rich-grid-renderer-contents)', stylus: 'display: block; transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'm.youtube.com', path: '^/watch|^/live', area: 'div.related-items-container > ytm-item-section-renderer > lazy-list', stylus: 'display: block; transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'm.youtube.com', path: '^/@.+/(videos|streams)|^/channel/.+/(videos|streams)|^/c/.+/(videos|streams)|^/user/.+/(videos|streams)|^/u/.+/(videos|streams)', area: 'ytm-browse ytm-tab-renderer > ytm-rich-grid-renderer > div.rich-grid-renderer-contents', stylus: 'display: block; transform: ' + scale + ' !important; pointer-events: none !important;' },
    { device: 'm.youtube.com', path: '^/results', area: 'ytm-search > ytm-section-list-renderer > lazy-list', stylus: 'transform: ' + scale + ' !important; pointer-events: none !important;' },
  ];
  const regWatch = '^/watch|^/live';
  const regSearch = '^/results';
  const regChannel = '^/@.+|^/channel/.+|^/c/.+|^/user/.+|^/u/.+';
  const abc = JSON.parse(window.sessionStorage.getItem('ABC')) || null;
  // 可変数
  let oldUrl = '';
  // ==========================================================
  // 静的style適用エリア
  const isDevice = 'www.youtube.com' === location.host ? true : false;
  // stylus: beforebegin, afterbegin, beforeend, afterend
  let appendStylus = '';
  // 非表示
  appendStylus += '.remove_item, .own_ch_NuN { display: none !important; } ';
  for (const yt of itemsArray) {
    if (isDevice) {
      // pc
      appendStylus += yt.area + ':not(:has(ytd-item-section-renderer > div#contents)) > *:not(.show) { display: none !important; /* visibility: hidden !important; **/ } ';
      appendStylus += yt.area + ':has(ytd-item-section-renderer > div#contents) ytd-item-section-renderer > div#contents > *:not(.show) { display: none !important; /* visibility: hidden !important; **/ } ';
    } else {
      // mobile
      appendStylus += yt.area + ':not(:has(ytm-item-section-renderer > lazy-list)) > *:not(.show) { display: none !important; /* visibility: hidden !important; **/ } ';
      appendStylus += yt.area + ':has(ytm-item-section-renderer > lazy-list) ytm-item-section-renderer > lazy-list > *:not(.show) { display: none !important; /* visibility: hidden !important; **/ } ';
    }
    appendStylus += yt.area + ' .target.minScale:not(:has(div[class*="subheader"i])) > * { ' + yt.stylus + ' } ';
    // [ショート]動画 削除
    appendStylus += yt.area + ' .target:has(a[href*="/shorts"i]) { display: none; } ';
    // [Mix & playlist] [他(headline)]動画 削除
    appendStylus += yt.area + ' .target:has(a[href*="&list="i], #rich-shelf-header-container, .rich-shelf-header, chips-shelf-with-video-shelf-renderer, ytd-brand-video-singleton-renderer, ytd-brand-video-shelf-renderer) { display: none; } ';
  }
  const stylusElem = document.createElement('style');
  stylusElem.id = 'stylusElemPage';
  stylusElem.textContent = appendStylus;

  const stylusElemCh = document.createElement('style');
  stylusElemCh.id = 'stylusElemCh';
  // ==========================================================

  // eslint-disable-next-line no-unused-vars
  const isNuN = (selector) => {
    if (selector === null || selector === undefined || selector === '') { return true; } else { return false; }
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelector = async (selector, node = document) => {
    let obj = null;
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 100));
      obj = node.querySelector(selector);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelectorCount = async (cnt, selector, node = document) => {
    let obj = null;
    let num = 0;
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 1000));
      if (num < cnt) {
        obj = node.querySelector(selector);
        num++;
        if (!obj) { return obj; }
      } else {
        break;
      }
    }
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 1000));
      obj = node.querySelector(selector);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelectorIframe = async (selector1, selector2, node = document) => {
    let obj = null;
    while (!obj) {
      // iframe.contentWindow.document === iframe.contentDocument
      await new Promise(resolve => setTimeout(resolve, 500));
      obj = node.querySelector(selector1).contentDocument.querySelector(selector2);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const deleteParam = (searchUrl, param) => {
    const base = new URL(location.protocol + '//' + location.hostname);
    const url = new URL(searchUrl, base);
    // URLSearchParamsオブジェクトを取得
    const params = url.searchParams;
    params.delete(param);

    return url;
  };
  // eslint-disable-next-line no-unused-vars
  const searchParams = (searchUrl, param) => {
    const base = new URL(location.protocol + '//' + location.hostname);
    const url = new URL(searchUrl, base);
    console.log('url section', url);
    // URLSearchParamsオブジェクトを取得
    const params = url.searchParams;

    return params.get(param);
  };
  // eslint-disable-next-line no-unused-vars
  const getParam = (name, url) => {
    if (!url) url = window.location.href;
    name = name.replace(/[\\[\]]/g, '\\$&');
    let regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)');
    let results = regex.exec(url);

    if (!results) return null;
    if (!results[2]) return '';
    return decodeURIComponent(results[2].replace(/\+/g, ' '));
  };
  // eslint-disable-next-line no-unused-vars
  const userAgent = () => {
    const userDevice = navigator.userAgent;
    if (userDevice.indexOf('iPhone') > 0 || userDevice.indexOf('iPod') > 0 || userDevice.indexOf('Android') > 0 && userDevice.indexOf('Mobile') > 0) {
      return false;
    } else if (userDevice.indexOf('iPad') > 0 || userDevice.indexOf('Android') > 0) {
      return false;
    } else {
      // pc
      return true;
    }
  };
  // eslint-disable-next-line no-unused-vars
  const stylusNone = (stylus) => {
    if (isNuN(document.querySelector('style#' + stylus))) {
      return true;
    }
    return false;
  };

  const removeMovieInformation = async (item, detail) => {
    const isDevice = 'www.youtube.com' === detail.host ? true : false;
    const mode = {'pc': {}, 'sp': {}};
    const youtubeItem = {};

    let flg = false;

    // channel Name
    const ownerA = 'div#owner > ytd-video-owner-renderer div#upload-info :is(ytd-channel-name#channel-name div#text-container a, yt-attributed-string span[class])'; // PC
    // channel ID [@xxx]形式
    const ownerB = 'ytm-slim-video-metadata-section-renderer > ytm-slim-video-action-bar-renderer > div.slim-video-action-bar-actions > a'; // mobile

    const ytMetaU = [ // username
      // pc
      ['div.ytLockupViewModelMetadata div.ytLockupMetadataViewModelTextContainer div.ytLockupMetadataViewModelMetadata div.ytContentMetadataViewModelMetadataRow > span'],
      ['div.ytLockupViewModelMetadata div.ytLockupMetadataViewModelTextContainer div.ytLockupMetadataViewModelMetadata div.ytContentMetadataViewModelMetadataRow a, div.ytLockupMetadataViewModelMetadata span.ytAttributedStringHost'],
      ['div#dismissible div#channel-info ytd-channel-name#channel-name a[href*="/@"]'],
      // mobile
      ['div.ytLockupViewModelMetadata div.ytLockupMetadataViewModelTextContainer div.ytLockupMetadataViewModelMetadata div.ytContentMetadataViewModelMetadataRow > span'],
    ].flat().join(', ');
    const ytMetaC = [ //channel, ID
      // pc
      ['div.ytLockupViewModelMetadata div.ytLockupMetadataViewModelTextContainer div.ytLockupMetadataViewModelMetadata div.ytContentMetadataViewModelMetadataRow a[href*="/@"]'],
      ['div#dismissible div#channel-info ytd-channel-name#channel-name a[href*="/@"]'],
      // mobile
      ['ytm-media-item div.media-item-details > div.media-channel a[href*="/@"]'],
    ].flat().join(', ');
    const ytMetaT = [ // title
      // pc
      ['div.ytLockupViewModelMetadata div.ytLockupMetadataViewModelTextContainer h3.ytLockupMetadataViewModelHeadingReset span'],
      ['h3.ytLockupMetadataViewModelHeadingReset'],
      ['div#dismissible div#meta a#video-title yt-formatted-string'],
      // mobile
      ['ytm-media-item div.media-item-details > div.media-item-info > div.media-item-metadata a > h3'],
      ['div.YtmCompactMediaItemMetadata h4.YtmCompactMediaItemHeadline'],
    ].flat().join(', ');

    if (isDevice) { // pc
      if (new RegExp(regWatch, 'gis').test(detail.path)) { // 動画エリア
        await waitQuerySelector(ownerA + ', ' + ownerB);
        let user = '';
        let ytChannel = '';
        // pc 動画
        mode.pc.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.pc.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.pc.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
        ytChannel = mode.pc.userNam;

        const channel = document.querySelector(ownerA);
        user = channel.textContent;
        if (user !== ytChannel) { item.classList.add('own_ch_NuN'); }

      } else if (new RegExp(regChannel, 'gis').test(detail.path)) { // チャンネルエリア
        // pc 動画
        mode.pc.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.pc.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.pc.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
      } else if (new RegExp(regSearch, 'gis').test(detail.path)) { // 検索結果
        // pc 動画
        mode.pc.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.pc.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.pc.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
      } else { // ホームなど
        // pc 動画
        mode.pc.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.pc.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.pc.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
      }
    } else { // mobile : sp
      if (new RegExp(regWatch, 'gis').test(detail.path)) { // 動画エリア
        await waitQuerySelector(ownerA + ', ' + ownerB);
        let user = '';
        let ytChannel = '';
        // mobile
        mode.sp.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.sp.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.sp.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
        ytChannel = mode.sp.userChN;

        const channel = document.querySelector(ownerB);
        user = channel.href;
        if (user !== ytChannel) { item.classList.add('own_ch_NuN'); }

      } else if (new RegExp(regChannel, 'gis').test(detail.path)) { // チャンネルエリア
        // mobile
        mode.sp.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.sp.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.sp.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
      } else if (new RegExp(regSearch, 'gis').test(detail.path)) { // 検索結果
        // mobile
        mode.sp.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.sp.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.sp.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
      } else { // ホームなど
        // mobile
        mode.sp.ytTitle = isNuN(item.querySelector(ytMetaT)) ? '' : item.querySelector(ytMetaT).textContent;
        mode.sp.userNam = isNuN(item.querySelector(ytMetaU)) ? '' : item.querySelector(ytMetaU).textContent;
        mode.sp.userChN = isNuN(item.querySelector(ytMetaC)) ? '' : item.querySelector(ytMetaC).href;
      }
    }
    const strData = isDevice ? mode.pc : mode.sp;
    youtubeItem.ytTitle = strData.ytTitle;
    youtubeItem.userNam = strData.userNam;
    youtubeItem.userChN = strData.userChN;

    // console.log('ytData > ', isDevice ? mode.pc : mode.sp);

    const words = isNuN(abc) ? '' : abc.hideword;
    const excludes = isNuN(abc) ? '' : abc.execludeWords;

    const txt = youtubeItem.userChN + ' : ' + youtubeItem.userNam + ' : ' + youtubeItem.ytTitle;
    for (const word of words) {
      if (new RegExp(word, 'gis').test(txt)) {
        youtubeItem.word = word;
        console.log('> hide all words : ', youtubeItem);
        flg = true;
        break;
      }
    }
    for (const word of excludes) {
      if (new RegExp(word, 'gis').test(txt)) {
        // console.log('> un hide words : ', youtubeItem);
        break;
      }
    }
    return flg;
  };
  const scaleShowMovie = async (area, item, detail) => {
    if (!item.classList.contains('target')) {
      // console.log('test2 1件ずつ', item);
      item.classList.add('target');
      const flg = await removeMovieInformation(item, detail);
      if (!flg) { item.classList.add('show', 'minScale'); } else { item.classList.add('remove_item', 'minScale'); }
    }
  };
  const itemList = async (area, detail) => {
    const isDevice = 'www.youtube.com' === detail.host ? true : false;

    let itemArea = area + ' > *:not(.target)';
    if (isDevice) {
      // pc
      itemArea = [
        area + ':not(:has(ytd-item-section-renderer > div#contents)) > *:not(.target)',
        area + ':has(ytd-item-section-renderer > div#contents) ytd-item-section-renderer > div#contents > *:not(.target)'
      ].join(',');
    } else {
      // mobile
      itemArea = [
        area + ':not(:has(ytm-item-section-renderer > lazy-list)) > *:not(.target)',
        area + ':has(ytm-item-section-renderer > lazy-list) ytm-item-section-renderer > lazy-list > *:not(.target)'
      ].join(',');
    }
    // 対象の検索(捜索)を10秒まで継続
    await waitQuerySelectorCount(10, itemArea);
    const items = document.querySelectorAll(itemArea);
    console.log('今回新たにヒットした件数:', items.length);
    return items;
  };
  const isLoopM = async (area, items, detail) => {
    for await (const el of items) {
      await scaleShowMovie(area, el, detail);
    }
  };
  const ytMovieShowCase = async (area, detail) => {
    let items = await itemList(area, detail);
    if (0 < items.length) {
      await isLoopM(area, items, detail);
      await ytMovieShowCase(area, detail);
    } else {
      console.log('yt movies list cnt stop');
    }
  };
  const changeUrl = () => {
    const observer = new MutationObserver(() => {
      setTimeout(() => { // 遅延
        window.dispatchEvent(new CustomEvent('urlChange', {'detail': { 'href': window.location.href, 'path': window.location.pathname, 'host': window.location.hostname, 'search': window.location.search }})); // イベントを発火
      }, 50);
    });
    const config = { 'subtree': true, 'childList': true, 'attributes': false, 'characterData': false };
    observer.observe(document.body, config);
  };
  // URL検知
  window.addEventListener('urlChange', async (e) => {
    if (oldUrl !== e.detail.path + e.detail.search) {
      oldUrl = e.detail.path + e.detail.search; // oldUrlを更新

      // youtube Channel Area Manager
      if (new RegExp(regChannel, 'gis').test(e.detail.path)) {
        const channelPC = 'ytd-browse[page-subtype="channels"i] #primary'; // channel タブ
        const channelPCItem = 'ytd-section-list-renderer[page-subtype="channels"i]';
        const channelSP = 'ytm-browse > .modern-tabs > div[is-channel="true"i] ~ div'; // channel タブ
        const channelEX = 'tsunomiyaP|UCSsBxdA7yg523PegCT7O7Mg';

        if ('www.youtube.com' === e.detail.host) {
          // [ホーム]だがホーム設定していない場合をケア
          stylusElemCh.textContent = 'body { visibility: hidden !important; } ';
          await waitQuerySelectorCount(10, channelPC + ' ' + channelPCItem);
          await new Promise(resolve => setTimeout(resolve, waitTime));
          // youtube Area Manager Manager:UserChannel
          if (new RegExp(channelEX, 'gis').test(location.pathname)) {
            stylusElemCh.textContent = '';
          } else if (new RegExp('(^/@.+|^/channel/.+|^/c/.+|^/user/.+|^/u/.+)(/videos|/streams|/playlists|/releases|/posts|/search|/community|/membership)', 'gis').test(e.detail.path)) {
            // [ホーム/home]タブ以外
            stylusElemCh.textContent = '';
          } else {
            const sectionPC = document.querySelector(channelPC);
            const sectionPCItem = document.querySelector(channelPC + ' ' + channelPCItem);
            isNuN(sectionPC) ? false : isNuN(sectionPCItem) ? false : sectionPCItem.remove();
            stylusElemCh.textContent = channelPC + ' { visibility: hidden !important; } ';
          }
        } else if ('m.youtube.com' === e.detail.host) {
          // [ホーム]だがホーム設定していない場合をケア
          stylusElemCh.textContent = 'body { visibility: hidden !important; } ';
          await new Promise(resolve => setTimeout(resolve, waitTime));
          // youtube Area Manager Manager:UserChannel
          if (new RegExp(channelEX, 'gis').test(e.detail.path)) {
            stylusElemCh.textContent = '';
          } else if (new RegExp('(^/@.+|^/channel/.+|^/c/.+|^/user/.+|^/u/.+)(/videos|/streams|/playlists|/releases|/posts|/search|/community|/membership)', 'gis').test(e.detail.path)) {
            // [ホーム/home]タブ以外
            stylusElemCh.textContent = '';
          } else {
            stylusElemCh.textContent = channelSP + ' { visibility: hidden !important; } ';
          }
        }
      } else {
        // channel外に移動後、stylus 削除
        stylusElemCh.textContent = '';
      }
      await waitQuerySelector(manager);
      await new Promise(resolve => setTimeout(resolve, 1000));

      // 初期処理
      const config = { 'subtree': true, 'childList': true, 'attributes': false, 'characterData': false };
      const ytArea = itemsArray.filter((yt) => e.detail.host === yt.device && new RegExp(yt.path, 'gis').test(e.detail.path));
      if (0 === ytArea.length) { return false; }

      await waitQuerySelector(ytArea[0].area);
      await ytMovieShowCase(ytArea[0].area, e.detail);

      const observer = new MutationObserver(() => {
        setTimeout(async () => { // 遅延
          observer.disconnect();
          await waitQuerySelector(ytArea[0].area);
          await ytMovieShowCase(ytArea[0].area, e.detail);
          console.log('yt next up movie list ... mutation index search');
          observer.observe(document.querySelector(ytArea[0].area), config);
        }, 5000);
      });
      observer.observe(document.querySelector(ytArea[0].area), config);

      document.addEventListener('click', async (e) => {
        if (e.target.classList.contains('target')) {
          let itemArea = '.target';
          // Array.from(items).forEach((el) => el.classList.add('minScale'));
          for await (const el of document.querySelectorAll(itemArea)) { el.classList.add('minScale'); }
          e.target.classList.remove('minScale');
        }
      });
    }
  });
  const eventHandler = () => {
    // DOM stylus
    if (stylusNone(stylusElem.id)) { document.body.insertAdjacentElement('afterbegin', stylusElem); }
    if (stylusNone(stylusElemCh.id)) { document.body.insertAdjacentElement('afterbegin', stylusElemCh); }

    changeUrl();
  };

  if (document.readyState !== 'loading') {
    // DOM解析が完了している場合は即実行
    eventHandler();
  } else {
    // DOM生成されたとき
    document.addEventListener('DOMContentLoaded', eventHandler());
  }
})();
