(function() {
  'use strict';

  // ==========================================================
  // 変数宣言
  const waitTime = 1000;
  const twMain = 'main[role="main"i]';
  const twColumns = 'div[data-testid="cellInnerDiv"i]';
  const xitemDom = 'stayofItem';
  const xitemRem = 'removeItem';
  const remReTweet = 'span[data-testid="socialContext"i]';
  const remAd = 'div[class="css-g5y9jx r-zl2h9q"i] div[class="css-g5y9jx r-1kkk96v"i] span[class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-1tl8opc"i]';
  const abc = JSON.parse(window.sessionStorage.getItem('ABC')) || null;
  // 可変数
  let twMutationManager;
  let oldUrl = '';
  let label = ''; // 現在のタブ
  // ==========================================================
  // stylus: beforebegin, afterbegin, beforeend, afterend
  let appendStylus = '';
  appendStylus += 'div[data-testid="cellInnerDiv"i] div:has(> div[data-testid="Tweet-User-Avatar"i]) { display: none !important; } ';
  appendStylus += 'a[href*="/grok.com/"i], div[data-testid="GrokDrawer"i], button[aria-label*="Grok"], button[aria-label="プロフィールの要約"i], button[aria-label="チャット"] { display: none !important; } ';
  /* gradient stylus :意味あるかは不明 */
  appendStylus += 'img[src*="twimg.com/emoji"i] { display: none !important; } ';
  /** css style border line */
  appendStylus += 'div[data-testid="cellInnerDiv"i] .r-1867qdf { border-radius: 0px !important; }';
  appendStylus += 'form[aria-label="検索"i] > div > div.r-sdzlij { border-bottom-left-radius: 0px !important; border-bottom-right-radius: 0px !important; border-top-left-radius: 0px !important; border-top-right-radius: 0px !important; }';
  // tweet hide
  appendStylus += 'section[aria-labelledby="accessible-list-0"i] > div[aria-label="タイムライン: 会話"i] > div > div[data-testid="cellInnerDiv"i]:not(.conversationX):not(.subTreeLinesX) { display: none !important; } ';
  appendStylus += 'div[data-testid="cellInnerDiv"i].' + xitemRem + ' { display: none !important; } ';
  appendStylus += 'div[data-testid="cellInnerDiv"i]:has(' + remReTweet + ') { display: none !important; } ';
  appendStylus += 'div[role="menu"i][class="css-g5y9jx r-j2cz3j r-14lw9ot r-1q9bdsx r-1upvrn0 r-1udh08x r-u8s1d"i]:has(div[data-testid="Dropdown"i] > div[role="menuitem"i]) { display: none !important; } ';
  // ext area stylus
  appendStylus += 'div[aria-label="トレンド"i] > div > div:not(:has(form[aria-label="検索"i])) { display: none !important; } ';
  appendStylus += 'nav[role="navigation"i] > a[href$="/i/grok"i], div[role="dialog"i] div:has(> a[href$="/i/grok"i]), nav[role="navigation"i] > a[href$="/communities"i], div[role="dialog"i] div:has(> a[href$="/communities"i]), nav[role="navigation"i] > a[href$="/i/premium_sign_up"i], div[role="dialog"i] div:has(> a[href$="/i/premium_sign_up"i]), nav[role="navigation"i] > a[href$="/i/verified-orgs-signup"i], div[role="dialog"i] div:has(> a[href$="/i/verified-orgs-signup"i]), nav[role="navigation"i] > a[href$="/jobs"i], div[role="dialog"i] div:has(> a[href$="/jobs"i]), nav[role="navigation"i] > a[href$="/i/jf/creators/studio"i], div[role="dialog"i] div:has(> a[href$="/i/jf/creators/studio"i]), nav[role="navigation"i] > a[href$="/i/chat"i], div[role="dialog"i] div:has(> a[href$="/i/chat"i]), nav[role="navigation"i] > a[href$="/i/monetization"i], div[role="dialog"i] div:has(> a[href$="/i/monetization"i]), nav[role="navigation"i] > a[href$="/i/connect_people"i], div[role="dialog"i] div:has(> a[href$="/i/connect_people"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href$="/i/premium_sign_up"i], div[role="dialog"i] div:has(> a[href$="/i/premium_sign_up"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href$="/i/verified-orgs-signup"i], div[role="dialog"i] div:has(> a[href$="/i/verified-orgs-signup"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href$="/i/jf/creators/studio"i], div[role="dialog"i] div:has(> a[href$="/i/jf/creators/studio"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href*="ads.x.com/"i], div[role="dialog"i] div:has(> a[href*="ads.x.com/"i]) { display: none !important; }';
  appendStylus += 'header[role="banner"i] div:has(> div > button[aria-label="アカウントメニュー"i]) { display: none !important; } ';
  // おすすめ
  appendStylus += 'div:is([aria-label^="タイムライン: "i]:not(:is([aria-label*="通知"i], [aria-label*="フォロー"i], [aria-label*="フォロワー"i], [aria-label*="ミュート"i], [aria-label*="ブロック"i], [aria-label*="リスト"i])), [aria-label$="さんのポスト"i]) > div > div[data-testid="cellInnerDiv"i]:not(:has(:is(article[data-testid="tweet"i], div[data-testid="trend"i], li[role="listitem"]))) { display : none !important; } ';
  // トレンドタブ：話題を検索 pc
  appendStylus += 'div[aria-label="ホームタイムライン"i] > div:has(div[role="presentation"i] > a[href$="/for_you"i][aria-selected="true"i]) ~ div:has(div[aria-label="タイムライン: 話題を検索"i]) { display: none !important; } ';
  // トレンドタブ：話題を検索 mobile
  appendStylus += 'div#react-root > div > div > div#layers:has(div[role="presentation"i] > a[href$="/for_you"i][aria-selected="true"i]) ~ div[dir="ltr"i]:has(div[aria-label="タイムライン: 話題を検索"i]) { display: none !important; } ';
  appendStylus += 'div[aria-label="ホームタイムライン"i] > div div[role="presentation"i] > a[href$="/news"i] { display: none !important; } ';
  appendStylus += 'div[aria-label="ホームタイムライン"i] > div div[role="presentation"i] > a[href$="/sports"i] { display: none !important; } ';
  appendStylus += 'div[aria-label="ホームタイムライン"i] > div div[role="presentation"i] > a[href$="/entertainment"i] { display: none !important; } ';
  // navigation
  appendStylus += 'nav[role="navigation"i] > a[href$="/i/grok"i], div[role="dialog"i] div:has(> a[href$="/i/grok"i]), nav[role="navigation"i] > a[href$="/communities"i], div[role="dialog"i] div:has(> a[href$="/communities"i]), nav[role="navigation"i] > a[href$="/i/premium_sign_up"i], div[role="dialog"i] div:has(> a[href$="/i/premium_sign_up"i]), nav[role="navigation"i] > a[href$="/i/verified-orgs-signup"i], div[role="dialog"i] div:has(> a[href$="/i/verified-orgs-signup"i]), nav[role="navigation"i] > a[href$="/jobs"i], div[role="dialog"i] div:has(> a[href$="/jobs"i]), nav[role="navigation"i] > a[href$="/i/jf/creators/studio"i], div[role="dialog"i] div:has(> a[href$="/i/jf/creators/studio"i]), nav[role="navigation"i] > a[href$="/i/chat"i], div[role="dialog"i] div:has(> a[href$="/i/chat"i]), nav[role="navigation"i] > a[href$="/i/monetization"i], div[role="dialog"i] div:has(> a[href$="/i/monetization"i]), nav[role="navigation"i] > a[href$="/i/connect_people"i], div[role="dialog"i] div:has(> a[href$="/i/connect_people"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href$="/i/premium_sign_up"i], div[role="dialog"i] div:has(> a[href$="/i/premium_sign_up"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href$="/i/verified-orgs-signup"i], div[role="dialog"i] div:has(> a[href$="/i/verified-orgs-signup"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href$="/i/jf/creators/studio"i], div[role="dialog"i] div:has(> a[href$="/i/jf/creators/studio"i]), div[role="menu"i] div[data-testid="Dropdown"i] a[href*="ads.x.com/"i], div[role="dialog"i] div:has(> a[href*="ads.x.com/"i]) { display: none !important; }';

  const stylusElem = document.createElement('style');
  stylusElem.id = 'stylusElemPage';
  stylusElem.textContent = appendStylus;
  // ==========================================================

  // eslint-disable-next-line no-unused-vars
  const isNuN = (selector) => {
    if (selector === null || selector === undefined || selector === '') { return true; } else { return false; }
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelector = async (selector, node = document) => {
    let obj = null;
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 100));
      obj = node.querySelector(selector);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelectorCount = async (cnt, selector, node = document) => {
    let obj = null;
    let num = 0;
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 1000));
      if (num < cnt) {
        obj = node.querySelector(selector);
        num++;
        if (!obj) { return obj; }
      } else {
        break;
      }
    }
    while (!obj) {
      await new Promise(resolve => setTimeout(resolve, 1000));
      obj = node.querySelector(selector);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const waitQuerySelectorIframe = async (selector1, selector2, node = document) => {
    let obj = null;
    while (!obj) {
      // iframe.contentWindow.document === iframe.contentDocument
      await new Promise(resolve => setTimeout(resolve, 500));
      obj = node.querySelector(selector1).contentDocument.querySelector(selector2);
    }
    return obj;
  };
  // eslint-disable-next-line no-unused-vars
  const deleteParam = (searchUrl, param) => {
    const base = new URL(location.protocol + '//' + location.hostname);
    const url = new URL(searchUrl, base);
    // URLSearchParamsオブジェクトを取得
    const params = url.searchParams;
    params.delete(param);

    return url;
  };
  // eslint-disable-next-line no-unused-vars
  const searchParams = (searchUrl, param) => {
    const base = new URL(location.protocol + '//' + location.hostname);
    const url = new URL(searchUrl, base);
    // console.log('url section', url);
    // URLSearchParamsオブジェクトを取得
    const params = url.searchParams;

    return params.get(param);
  };
  // eslint-disable-next-line no-unused-vars
  const getParam = (name, url) => {
    if (!url) url = window.location.href;
    name = name.replace(/[\\[\]]/g, '\\$&');
    let regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)');
    let results = regex.exec(url);

    if (!results) return null;
    if (!results[2]) return '';
    return decodeURIComponent(results[2].replace(/\+/g, ' '));
  };
  // eslint-disable-next-line no-unused-vars
  const buildURL = (baseUrl, paramsObject) => {
    const url = new URL(baseUrl);
    url.search = new URLSearchParams(paramsObject).toString();
    return url.toString();
  };
  // eslint-disable-next-line no-unused-vars
  const userAgent = () => {
    const userDevice = navigator.userAgent;
    if (userDevice.indexOf('iPhone') > 0 || userDevice.indexOf('iPod') > 0 || userDevice.indexOf('Android') > 0 && userDevice.indexOf('Mobile') > 0) {
      return false;
    } else if (userDevice.indexOf('iPad') > 0 || userDevice.indexOf('Android') > 0) {
      return false;
    } else {
      // pc
      return true;
    }
  };
  // eslint-disable-next-line no-unused-vars
  const stylusNone = (stylus) => {
    if (isNuN(document.querySelector('style#' + stylus))) {
      return true;
    }
    return false;
  };

  const switchToNewestReplies = async (href) => {
    // const menu = document.querySelector('div[aria-label="タイムライン: 会話"i] div[class="css-g5y9jx r-1awozwy r-18u37iz r-1wtj0ep r-6gpygo"i] button[aria-haspopup="menu"i]');
    // f (menu.textContent !== '最新') { menu.click(); }
    // const dropdownLists = await document.querySelectorAll('div[role="menu"i][class="css-g5y9jx r-j2cz3j r-14lw9ot r-1q9bdsx r-1upvrn0 r-1udh08x r-u8s1d"i] div[data-testid="Dropdown"i] > div[role="menuitem"i]');
    // dropdownLists.item(1).click(); // 最新 : sort_replies=recency
    // const replaceURL = deleteParam(window.location.href, 'sort_replies').href;
    // history.replaceState(null, '', replaceURL);
    if (searchParams(href, 'sort_replies')) {
      console.log('> tweet is sort ... recency replacement.');
    } else {
      const search = buildURL(href, { sort_replies: 'recency' });
      location.replace(search);
    }
  };
  const tweetMoreLines = async (e) => {
    if (e.detail.path.includes('/status/')) {
      await switchToNewestReplies(e.detail.href);

      const showMoreLine = await waitQuerySelector('section[aria-labelledby="accessible-list-0"i] > div[aria-label="タイムライン: 会話"i] > div');
      await waitQuerySelector(twColumns);

      // 子要素取得
      const timelineItems = Array.from(showMoreLine.querySelectorAll(twColumns));
      const conversation = timelineItems[0];
      conversation.classList.add('conversationX');

      const counterTxt = 'button[data-testid="reply"i] span[data-testid="app-text-transition-container"i]';
      const count = isNuN(conversation.querySelector(counterTxt)) ? 0 : conversation.querySelector(counterTxt).textContent;

      // 返信のみ抽出
      const subtree = timelineItems.slice(1);
      console.log('tweet 会話 > ', count, timelineItems);
      const len = parseInt(count, 10); // 10進数変換
      for (let i = 0; i < len; i++) {
        subtree[i].classList.add('subTreeLinesX');
      }
    }
  };
  const removeElements = async (e) => {
    let nodeTimeline = await waitQuerySelector('div[aria-label^="タイムライン: "i] > div');
    if (e.detail.path.includes('/status/')) {
      // 会話の場合、読み込みは会話内のみでよい
      nodeTimeline = await waitQuerySelector('section[aria-labelledby="accessible-list-0"i] > div[aria-label="タイムライン: 会話"i] > div');
    } else {
      nodeTimeline = await waitQuerySelector('div[aria-label^="タイムライン: "i] > div');
    }
    await waitQuerySelector(twColumns);
    await new Promise(resolve => setTimeout(resolve, waitTime));
    const timelineItems = nodeTimeline.querySelectorAll(twColumns + ':not(.' + xitemDom + ')');

    console.log('tweet remove item length > ', timelineItems.length);
    for (const tweet of timelineItems) {
      tweet.classList.add(xitemDom);
      // 広告
      isNuN(tweet.querySelector(remAd)) ? '' : tweet.querySelector(remAd).textContent !== '広告' ? '' : tweet.classList.add(xitemRem);

      const words = isNuN(abc) ? [] : abc.hideword;
      // 非表示対象文字列
      for (const word of words) {
        const regWord = new RegExp(word, 'gis');
        if (regWord.test(tweet.textContent)) {
          console.log([word, tweet.textContent]);
          // tweet.style.setProperty('display', 'none', 'important');
          tweet.classList.add(xitemRem);
          break;
        }
      }
    }
  };
  const twPath = async (e, nodeMain) => {
    // Mutation Observer
    const config = { 'attributes': false, 'childList': true, 'subtree': true };
    twMutationManager = new MutationObserver(async () => {
      await tweetMoreLines(e);
      await removeElements(e);
    });
    twMutationManager.observe(nodeMain, config);
  };
  const changeUrl = () => {
    const observer = new MutationObserver(() => {
      setTimeout(() => { // 遅延
        window.dispatchEvent(new CustomEvent('urlChange', {'detail': { 'href': window.location.href, 'path': window.location.pathname, 'host': window.location.hostname, 'search': window.location.search }})); // イベントを発火
      }, 50);
    });
    const config = { 'subtree': true, 'childList': true, 'attributes': false, 'characterData': false };
    observer.observe(document.body, config);
  };
  // URL検知
  window.addEventListener('urlChange', async (e) => {
    const tab = await waitQuerySelectorCount(10, 'div[role="presentation"i] div[role="tab"i][aria-selected="true"i] span');
    const tabLabel = isNuN(tab) ? 'NuN' : tab.textContent;

    if (oldUrl !== e.detail.path || label !== tabLabel) {
      oldUrl = e.detail.path; // oldUrlを更新
      label = tabLabel;
      console.log('tab : ', label, '、URL : ', oldUrl);

      if (!isNuN(twMutationManager)) { twMutationManager.disconnect(); }

      const nodeMain = await waitQuerySelector(twMain);
      await twPath(e, nodeMain);
    }
  });
  const eventHandler = () => {
    if (stylusNone(stylusElem.id)) { document.body.insertAdjacentElement('afterbegin', stylusElem); }

    changeUrl();
  };

  if (document.readyState !== 'loading') {
    // DOM解析が完了している場合は即実行
    eventHandler();
  } else {
    // DOM生成されたとき
    document.addEventListener('DOMContentLoaded', eventHandler());
  }
})();
