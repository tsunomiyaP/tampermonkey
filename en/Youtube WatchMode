      // 動画要素サイズ変更時、再生バー位置サイズ変更
      const num = parseInt(ytVid.style.width) + parseInt(ytVid.style.left) * 2;
      primary.style.width = num + 'px';
      // console.log('> yt reload... resize... ytMobPlayer');
    });
    ytMobPlayer.observe(document.querySelector(player), config);
  };

